	partition dim_date = m
		mode: import
		source =
				let
					CalendarStart = #date(2023, 1, 1),
					CalendarEnd = #date(2025, 12, 31),
					DateList = List.Dates(CalendarStart, Duration.Days(CalendarEnd - CalendarStart) + 1, #duration(1, 0, 0, 0)),
					DateTable = Table.FromList(DateList, Splitter.SplitByNothing(), {"Date"}),
					TypedDate = Table.TransformColumnTypes(DateTable, {{"Date", type date}}),
					AddYear = Table.AddColumn(TypedDate, "Year", each Date.Year([Date]), Int64.Type),
					AddQuarterNumber = Table.AddColumn(AddYear, "QuarterNumber", each Date.QuarterOfYear([Date]), Int64.Type),
					AddQuarter = Table.AddColumn(AddQuarterNumber, "Quarter", each "Q" & Text.From([QuarterNumber]), type text),
					AddYearQuarter = Table.AddColumn(AddQuarter, "YearQuarter", each Text.From([Year]) & "-Q" & Text.From([QuarterNumber]), type text),
					AddYearQuarterSort = Table.AddColumn(AddYearQuarter, "YearQuarterSort", each [Year] * 10 + [QuarterNumber], Int64.Type),
					AddMonthNumber = Table.AddColumn(AddYearQuarterSort, "MonthNumber", each Date.Month([Date]), Int64.Type),
					AddMonthName = Table.AddColumn(AddMonthNumber, "MonthName", each Date.ToText([Date], "MMMM", "en-US"), type text),
					AddYearMonth = Table.AddColumn(AddMonthName, "YearMonth", each Date.ToText([Date], "yyyy-MM", "en-US"), type text),
					AddYearMonthSort = Table.AddColumn(AddYearMonth, "YearMonthSort", each [Year] * 100 + [MonthNumber], Int64.Type),
					AddMonthStart = Table.AddColumn(AddYearMonthSort, "MonthStart", each Date.StartOfMonth([Date]), type date),
					AddDayOfMonth = Table.AddColumn(AddMonthStart, "DayOfMonth", each Date.Day([Date]), Int64.Type),
					AddDayOfWeekNumber = Table.AddColumn(AddDayOfMonth, "DayOfWeekNumber", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
					AddDayOfWeek = Table.AddColumn(AddDayOfWeekNumber, "DayOfWeek", each Date.ToText([Date], "dddd", "en-US"), type text)
				in
					AddDayOfWeek

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

