table fact_sales
	lineageTag: d05a750a-215a-4e34-ab6d-a297e0c356e0

	measure 'Total Orders' = DISTINCTCOUNT(fact_sales[OrderID])
		formatString: 0
		displayFolder: Sales
		lineageTag: 2a5c5a2d-d9d2-4c6b-93e8-44810d7dd46f

	measure 'Total Revenue' = SUMX(fact_sales, fact_sales[Units] * fact_sales[UnitPrice])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Sales
		lineageTag: 78fff542-c49f-4ba8-814d-da5ba985b9ef

	measure 'Units Sold' = SUM(fact_sales[Units])
		formatString: #,0
		displayFolder: Sales
		lineageTag: 67692349-f313-4501-9c04-40fcb0865c1e

	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Sales
		lineageTag: 4467b1f1-2713-48d8-9ff9-a39bdc0fc490

	measure 'Revenue per Unit' = DIVIDE([Total Revenue], [Units Sold])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Sales
		lineageTag: 7c9da9b4-b1e4-44ee-873d-e82038db0d18

	measure 'Revenue Rank by Product' = RANKX(ALL(dim_product[ProductName]), [Total Revenue], , DESC, DENSE)
		formatString: 0
		displayFolder: Analysis
		lineageTag: 2e5617a5-74d9-4ac5-804a-b5e7eed3415e

	measure 'Revenue % of Total' =
			DIVIDE(
				[Total Revenue],
				CALCULATE(
					[Total Revenue],
					REMOVEFILTERS(dim_product),
					REMOVEFILTERS(dim_region),
					REMOVEFILTERS(dim_channel)
				)
			)
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Analysis
		lineageTag: 8b3c834c-0be1-49ed-b7c0-1d6149cf6130

	measure 'Current Month Revenue' = CALCULATE([Total Revenue], DATESMTD(dim_date[Date]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time Intelligence
		lineageTag: 67b9ab89-8329-4481-8e9e-4f7b9b9ed875

	measure 'Previous Month Revenue' = CALCULATE([Total Revenue], PREVIOUSMONTH(dim_date[Date]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time Intelligence
		lineageTag: d88f7178-e34c-43fc-95e3-f9174def3e48

	measure 'Month-over-Month Growth %' =
			DIVIDE(
				[Current Month Revenue] - [Previous Month Revenue],
				[Previous Month Revenue]
			)
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Time Intelligence
		lineageTag: 8e925796-dd80-4d64-9222-f2cf86511ff2

	measure 'Year-to-Date Revenue' = TOTALYTD([Total Revenue], dim_date[Date])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time Intelligence
		lineageTag: 5d058c2f-1f75-4b1f-96d6-951a41e54714

	measure 'Previous Year Revenue' = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[Date]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time Intelligence
		lineageTag: 7fd5a079-4ef7-4bd2-ad0d-6c606cc8ec5a

	measure 'Year-over-Year Growth %' =
			DIVIDE(
				[Total Revenue] - [Previous Year Revenue],
				[Previous Year Revenue]
			)
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Time Intelligence
		lineageTag: 27592c96-9f83-4e89-a728-a8f5058a71ba

